# Docker Compose host ports
MYSQL_HOST_PORT=3306
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Application
SPRING_PROFILES_ACTIVE=demo
APPROVAL_PROVIDER=local

# Optional DX-OS integration settings
DXOS_ACCEPT_LEVEL=SAFE
DXOS_APP_NAME=ttcsn
DXOS_HOST_PORT=19080
DXOS_POSTGRES_HOST_PORT=127.0.0.1:55432
DXOS_BASE_URL=http://host.docker.internal:19080
DXOS_MODEL=ttcsn_order_approval
DXOS_ENTITY=approval
DXOS_REALM=dxos
DXOS_CONNECT_TIMEOUT=3s
DXOS_READ_TIMEOUT=8s

# Filled automatically by scripts/setup-dxos.sh.
DXOS_REQUESTER_CLIENT_ID=
DXOS_REQUESTER_CLIENT_SECRET=
DXOS_APPROVER_CLIENT_ID=
DXOS_APPROVER_CLIENT_SECRET=

# Database used by Docker Compose
MYSQL_DATABASE=highlands
MYSQL_USER=highlands
MYSQL_PASSWORD=highlands
MYSQL_ROOT_PASSWORD=root

# Database used when running the backend directly on the host
DB_URL=jdbc:mysql://localhost:3306/coffee_order_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
SHIPPING_FEE=15000
FREE_SHIPPING_THRESHOLD=200000

# JWT: base64-encoded secret with at least 32 bytes before encoding
JWT_SECRET=
MFA_ENCRYPTION_KEY=
JWT_EXPIRATION_MINUTES=120
JWT_ISSUER=moc-nhien-order-api
JWT_AUDIENCE=moc-nhien-web
